{
  "name": "zenth",
  "version": "1.0.1",
  "description": "Professional Autonomous Self-Learning Crypto Paper Trading Terminal & Bot with Multi-Exchange Ingestion & Pluggable Memory",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "zenth": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build && tsx scripts/prepare_npm_readme.ts prepare",
    "postpack": "tsx scripts/prepare_npm_readme.ts restore",
    "test": "tsx tests/run_all_tests.ts",
    "test:all": "tsx tests/run_all_tests.ts",
    "start": "tsx src/cli.ts start",
    "zenth": "tsx src/cli.ts start",
    "onboard": "tsx src/cli.ts onboard",
    "scan": "tsx src/cli.ts scan",
    "replay:raw": "tsx src/cli.ts replay:raw",
    "replay:memory": "tsx src/cli.ts replay:memory",
    "memory:reset": "tsx src/cli.ts memory:reset",
    "db:reset": "tsx src/cli.ts db:reset"
  },
  "keywords": [
    "trading-bot",
    "crypto-trading",
    "paper-trading",
    "binance",
    "coinbase",
    "okx",
    "upbit",
    "bitget",
    "xt-exchange",
    "supabase",
    "sqlite",
    "mongodb",
    "postgresql",
    "typescript",
    "self-learning",
    "tui",
    "terminal",
    "zenth"
  ],
  "author": "ROVOID",
  "license": "GPL-3.0",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "dotenv": "^17.4.2",
    "mongodb": "^7.6.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
